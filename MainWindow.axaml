<Window x:Class="Padel.Manager.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Padel.Manager"
        xmlns:tabs="clr-namespace:Padel.Manager.Views"
        Title="{x:Static local:AppText.MainWindowTitle}"
        Height="720"
        Width="1280"
        MinHeight="720"
        MinWidth="1280"
        Background="#F4F6FB">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                Margin="0,0,0,10"
                CornerRadius="8"
                Background="#0F2A52">
            <Border.Styles>
                <Style Selector="Button">
                    <Setter Property="Background" Value="#1A3F73" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#2A5298" />
                </Style>
                <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#0D2244" />
                </Style>
            </Border.Styles>
            <DockPanel>
                <Button Content="Exporter en XLSX"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Padding="14,6"
                        Click="ExportDataButton_OnClick" />
                <Button x:Name="ChangeDatasetButton"
                        Content="Changer de dataset"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Padding="14,6"
                        Click="ChangeDatasetButton_OnClick" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DatasetNameTextBlock"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold" />
                    <TextBlock x:Name="WorkbookPathTextBlock"
                               Foreground="#9BBFE0"
                               FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabControl"
                    Grid.Row="1"
                    Background="White"
                    FontSize="14"
                    SelectionChanged="MainTabControl_OnSelectionChanged">
            <TabItem Header="Joueurs">
                <tabs:PlayersTabView x:Name="PlayersTab" />
            </TabItem>

            <TabItem Header="Matches">
                <tabs:MatchesTabView x:Name="MatchesTab" />
            </TabItem>

            <TabItem Header="Tournois">
                <tabs:TournamentTabView x:Name="TournamentTab" />
            </TabItem>

            <TabItem x:Name="ScoresTabItem" Header="Scores">
                <tabs:ScoresTabView x:Name="ScoresTab" />
            </TabItem>

            <TabItem x:Name="LeaderboardTabItem" Header="Classement">
                <tabs:LeaderboardTabView x:Name="LeaderboardTab" />
            </TabItem>

            <TabItem Header="Paramètres">
                <tabs:SettingsTabView x:Name="SettingsTab" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10"
                CornerRadius="6"
                BorderBrush="#D8DDE8"
                BorderThickness="1"
                Background="#FFFFFF">
            <TextBlock x:Name="StatusTextBlock" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
