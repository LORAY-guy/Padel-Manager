<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Padel Manager</title>
    <HeadOutlet />
    <style>
        :root {
            --navy: #0F2A52;
            --navy-sub: #9BBFE0;
            --btn: #1A3F73;
            --btn-hover: #2A5298;
            --btn-press: #0D2244;
            --bg: #F4F6FB;
            --card: #FFFFFF;
            --info: #EAF1FF;
            --border: #D8DDE8;
            --border-subtle: #E8EDF5;
            --text: #1f2937;
            --muted: #666666;
            --very-muted: #999999;
            --accent-text: #3A4C73;
        }
        * { box-sizing: border-box; }
        html { -webkit-text-size-adjust: 100%; }
        body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--text); }

        /* Header */
        header.app-header { background: var(--navy); color: #fff; padding: 12px 16px; display: flex; align-items: center; gap: 12px; box-shadow: 0 1px 4px rgba(0,0,0,.15); }
        header.app-header .brand { color: #fff; text-decoration: none; font-weight: 700; font-size: 18px; display: flex; align-items: center; gap: 8px; }
        header.app-header .spacer { flex: 1; }
        header.app-header .user { color: var(--navy-sub); font-size: 13px; }
        header.app-header form { margin: 0; }

        main { max-width: 820px; margin: 0 auto; padding: 16px 16px 40px; }
        h1 { font-size: 20px; margin: 6px 0 14px; color: var(--navy); }
        h3 { color: var(--accent-text); }
        a { color: var(--btn); }
        .muted { color: var(--muted); font-size: 13px; }

        /* Sub-nav: back link + tab strip */
        .subnav { margin: 0 0 14px; }
        .home-link { display: inline-block; font-size: 13px; color: var(--muted); text-decoration: none; margin-bottom: 8px; }
        .home-link:hover { color: var(--navy); }
        nav.tabs { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; -webkit-overflow-scrolling: touch; }
        nav.tabs::-webkit-scrollbar { height: 0; }
        .tab { flex: 0 0 auto; padding: 8px 14px; border-radius: 8px; text-decoration: none; font-size: 14px; font-weight: 500; color: var(--accent-text); background: var(--info); white-space: nowrap; border: 1px solid transparent; }
        .tab:hover { background: #dce7fb; }
        .tab.active { background: var(--navy); color: #fff; }
        .tab.cta { background: var(--btn); color: #fff; }
        .tab.cta:hover { background: var(--btn-hover); }

        /* Buttons */
        button, .btn { background: var(--btn); color: #fff; border: 0; border-radius: 8px; padding: 10px 18px; font-size: 15px; font-weight: 600; cursor: pointer; font-family: inherit; }
        button:hover, .btn:hover { background: var(--btn-hover); }
        button:active { background: var(--btn-press); }
        button.secondary { background: #5b6b85; }
        button.secondary:hover { background: #6b7c98; }
        button.danger { background: #b91c1c; }
        button.danger:hover { background: #a11616; }
        button.link { background: none; color: var(--btn); padding: 0; font-weight: 500; font-size: 13px; text-decoration: underline; }

        /* Cards & forms */
        .card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 16px; box-shadow: 0 1px 2px rgba(15,42,82,.04); }
        .card strong { color: var(--navy); }
        label { display: block; margin-bottom: 12px; font-size: 13px; color: var(--muted); }
        input, select { display: block; width: 100%; padding: 10px 11px; margin-top: 4px; border: 1px solid var(--border); border-radius: 8px; font-size: 15px; background: #fff; color: var(--text); font-family: inherit; }
        input[type=checkbox] { width: auto; display: inline-block; }
        input:focus, select:focus { outline: none; border-color: var(--btn); box-shadow: 0 0 0 3px rgba(26,63,115,.12); }
        .card fieldset { border: 1px solid var(--border); border-radius: 8px; padding: 10px; margin: 0 0 12px; }
        .card fieldset legend { font-size: 12px; color: var(--muted); padding: 0 4px; }
        .card fieldset label { margin-bottom: 8px; }

        .banner-ok { color: #15803d; background: #dcfce7; padding: 9px 12px; border-radius: 8px; }
        .banner-err, .error { color: #b91c1c; background: #fee2e2; padding: 9px 12px; border-radius: 8px; }

        /* Lists (datasets) */
        ul.list { list-style: none; padding: 0; margin: 0; }
        ul.list li { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 13px 15px; margin-bottom: 9px; display: flex; align-items: center; gap: 10px; box-shadow: 0 1px 2px rgba(15,42,82,.04); }
        ul.list li a { font-weight: 600; font-size: 16px; text-decoration: none; color: var(--navy); }

        /* Tables */
        table.lb { width: 100%; border-collapse: collapse; background: var(--card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
        table.lb th, table.lb td { padding: 10px 11px; text-align: left; border-bottom: 1px solid var(--border-subtle); font-size: 14px; }
        table.lb th { background: var(--info); font-size: 12px; color: var(--accent-text); font-weight: 600; }
        table.lb tr:last-child td { border-bottom: 0; }
        table.lb td.num, table.lb th.num { text-align: right; }
        table.lb tr.p1 td { background: #FFF4CF; }
        table.lb tr.p2 td { background: #F5F7FA; }
        table.lb tr.p3 td { background: #FBEFE7; }
        table.lb tr.p1 td:first-child { font-weight: 700; color: #7E5B00; }

        /* Match rows */
        .match-card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 11px 12px; margin-bottom: 8px; box-shadow: 0 1px 2px rgba(15,42,82,.04); }
        .match-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .match-row .team { flex: 1 1 120px; min-width: 110px; }
        .match-row .team.b { text-align: right; }
        .score-in { width: 56px; text-align: center; padding: 7px; margin: 0; }
        .win { font-weight: 700; color: var(--navy); }
    </style>
</head>
<body>
    <Routes />
</body>
</html>
