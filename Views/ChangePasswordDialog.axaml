<Window x:Class="Padel.Manager.Views.ChangePasswordDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changer le mot de passe"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Changer le mot de passe du serveur"
                   FontWeight="Bold"
                   FontSize="14" />
        <StackPanel Spacing="4">
            <TextBlock Text="Mot de passe actuel" FontSize="11" Foreground="{DynamicResource TextMuted}" />
            <TextBox x:Name="CurrentBox" PasswordChar="•" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Nouveau mot de passe" FontSize="11" Foreground="{DynamicResource TextMuted}" />
            <TextBox x:Name="NewBox" PasswordChar="•" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Text="Confirmer le nouveau mot de passe" FontSize="11" Foreground="{DynamicResource TextMuted}" />
            <TextBox x:Name="ConfirmBox" PasswordChar="•" />
        </StackPanel>
        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="IndianRed"
                   IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button x:Name="SaveButton"
                    Content="Enregistrer"
                    FontWeight="SemiBold"
                    Padding="18,7"
                    Click="SaveButton_OnClick" />
            <Button Content="Annuler" Padding="14,7" Click="CancelButton_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
