<Window x:Class="Padel.Manager.Views.EditMatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier les joueurs du match" 
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FB">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Margin="0,0,0,15"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Text="Sélectionnez les joueurs pour remplacer ceux qui ne peuvent pas jouer" />

        <!-- Team A Section -->
        <GroupBox Grid.Row="1" Header="Équipe A" Margin="0,0,0,15" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="Joueur 1" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ComboBox x:Name="TeamAPlayer1ComboBox" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Text="Joueur 2" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ComboBox x:Name="TeamAPlayer2ComboBox" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" 
                           x:Name="TeamACurrentLabel"
                           FontSize="11"
                           Foreground="#666" 
                           TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <!-- Team B Section -->
        <GroupBox Grid.Row="2" Header="Équipe B" Margin="0,0,0,15" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="Joueur 1" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ComboBox x:Name="TeamBPlayer1ComboBox" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Text="Joueur 2" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ComboBox x:Name="TeamBPlayer2ComboBox" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" 
                           x:Name="TeamBCurrentLabel"
                           FontSize="11"
                           Foreground="#666" 
                           TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                    Content="Annuler" 
                    Padding="20,10"
                    Click="CancelButton_OnClick" />
            <Button Grid.Column="2" 
                    Content="Appliquer" 
                    Padding="20,10"
                    Background="#0F2A52"
                    Foreground="White"
                    Click="ApplyButton_OnClick" />
        </Grid>
    </Grid>
</Window>
