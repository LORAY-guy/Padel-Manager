<UserControl x:Class="Padel.Manager.Views.LeaderboardTabView"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10" Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,10,10,0">
                <TextBlock Text="Classement global"
                           FontWeight="Bold"
                           FontSize="22"
                           Foreground="{DynamicResource AccentText}"
                           VerticalAlignment="Center" />
                <Border x:Name="AmericanoBadge"
                        IsVisible="False"
                        Margin="10,0,0,0"
                        Padding="8,3"
                        CornerRadius="4"
                        Background="#1A7F4B"
                        VerticalAlignment="Center">
                    <TextBlock Text="AMERICANO"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="Bold" />
                </Border>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="Joueurs / feuille"
                       VerticalAlignment="Center"
                       Margin="0,10,8,0"
                       Foreground="{DynamicResource AccentText}"
                       FontWeight="SemiBold" />

            <TextBox Grid.Column="2"
                     x:Name="PlayersPerSheetTextBox"
                     Width="64"
                     Height="30"
                     VerticalAlignment="Center"
                     HorizontalContentAlignment="Center"
                     Margin="0,10,12,0"
                     Text="20"
                     LostFocus="PlayersPerSheetTextBox_OnLostFocus"
                     KeyDown="PlayersPerSheetTextBox_OnKeyDown" />

            <Button Grid.Column="3"
                    Content="Exporter classement (Images)"
                    Padding="16,8"
                    Margin="0,10,0,0"
                    Click="ExportLeaderboardImageButton_OnClick" />

            <Button Grid.Column="4"
                    Content="Imprimer"
                    Padding="16,8"
                    Margin="8,10,10,0"
                    Click="PrintLeaderboardButton_OnClick" />
        </Grid>

        <Border Grid.Row="1"
                x:Name="LeaderboardPrintablePanel"
                Padding="16"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource DataGridBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <Grid x:Name="LeaderboardPrintableContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="0,0,0,12"
                        Padding="12"
                        CornerRadius="6"
                        BorderBrush="{DynamicResource BorderAccent}"
                        BorderThickness="1"
                        Background="{DynamicResource InfoPanelBackground}">
                    <StackPanel>
                        <TextBlock x:Name="LeaderboardTitleTextBlock"
                                   Text="CLASSEMENT GLOBAL"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentText}" />
                        <TextBlock x:Name="LeaderboardSubtitleTextBlock"
                                   Text=""
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource LeaderboardSubtitle}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="10" CornerRadius="6" BorderBrush="{DynamicResource Podium2Border}" BorderThickness="1" Background="{DynamicResource Podium2Background}">
                        <StackPanel>
                            <TextBlock Text="2ème" FontWeight="Bold" Foreground="{DynamicResource Podium2Label}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SecondPlace.Name, ElementName=Root}" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SecondPlaceScore, ElementName=Root, StringFormat=\{0\} pts}" HorizontalAlignment="Center" Foreground="{DynamicResource Podium2Score}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="10" CornerRadius="6" BorderBrush="{DynamicResource Podium1Border}" BorderThickness="1" Background="{DynamicResource Podium1Background}">
                        <StackPanel>
                            <TextBlock Text="1er" FontWeight="Bold" Foreground="{DynamicResource Podium1Label}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding FirstPlace.Name, ElementName=Root}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FirstPlaceScore, ElementName=Root, StringFormat=\{0\} pts}" HorizontalAlignment="Center" Foreground="{DynamicResource Podium1Score}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Padding="10" CornerRadius="6" BorderBrush="{DynamicResource Podium3Border}" BorderThickness="1" Background="{DynamicResource Podium3Background}">
                        <StackPanel>
                            <TextBlock Text="3ème" FontWeight="Bold" Foreground="{DynamicResource Podium3Label}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ThirdPlace.Name, ElementName=Root}" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ThirdPlaceScore, ElementName=Root, StringFormat=\{0\} pts}" HorizontalAlignment="Center" Foreground="{DynamicResource Podium3Score}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <DataGrid Grid.Row="2"
                          x:Name="LeaderboardDataGrid"
                          ItemsSource="{Binding RankedSummaries, ElementName=Root}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource DataGridLinesBrush}"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource DataGridBorderBrush}"
                          RowBackground="{DynamicResource DataGridRowBackground}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="55" />
                        <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" MinWidth="180" />
                        <DataGridTextColumn Header="Joués" Binding="{Binding MatchesPlayed}" Width="95" />
                        <DataGridTextColumn Header="Gagnés" Binding="{Binding MatchesWon}" Width="95" />
                        <DataGridTextColumn Header="Points" Binding="{Binding TotalPoints}" Width="90" />
                        <DataGridTextColumn Header="Pts marqués" Binding="{Binding TotalScoredGames}" Width="100" />
                        <DataGridTextColumn Header="Moyenne" Binding="{Binding AveragePoints, StringFormat=F2}" Width="100" />
                        <DataGridTextColumn Header="Forme récente" Binding="{Binding RecentFormDisplay}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
