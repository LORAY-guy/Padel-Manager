<Window x:Class="Padel.Manager.Views.ServerBrowserDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serveur Padel"
        Width="520"
        Height="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Connection -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Connexion au serveur"
                       FontWeight="Bold"
                       FontSize="14" />
            <TextBlock Text="Adresse du serveur"
                       FontSize="11"
                       Foreground="{DynamicResource TextMuted}" />
            <TextBox x:Name="UrlTextBox"
                     Watermark="http://192.168.1.10:5080" />
            <Grid ColumnDefinitions="*,8,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Identifiant" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                    <TextBox x:Name="UsernameTextBox" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Mot de passe" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                    <TextBox x:Name="PasswordTextBox" PasswordChar="•" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ConnectButton"
                        Content="Se connecter"
                        Padding="20,7"
                        FontWeight="SemiBold"
                        Click="ConnectButton_OnClick" />
                <Button x:Name="RegisterButton"
                        Content="Créer un compte"
                        Padding="14,7"
                        Click="RegisterButton_OnClick" />
                <Button x:Name="ChangePasswordButton"
                        Content="Changer le mot de passe…"
                        Padding="14,7"
                        IsVisible="False"
                        Click="ChangePasswordButton_OnClick" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Height="1"
                Margin="0,14"
                Background="{DynamicResource BorderNormal}" />

        <TextBlock Grid.Row="2"
                   Text="Datasets du serveur"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Foreground="{DynamicResource TextMuted}"
                   Margin="0,0,0,8" />

        <Border Grid.Row="3"
                BorderBrush="{DynamicResource BorderNormal}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <ListBox x:Name="ServerListBox"
                         Padding="2"
                         Background="Transparent"
                         SelectionChanged="ServerListBox_OnSelectionChanged"
                         DoubleTapped="ServerListBox_OnDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,5">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding SubText}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextVeryMuted}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ServerEmptyText"
                           Text="Connectez-vous pour voir les datasets du serveur."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPlaceholder}"
                           FontStyle="Italic"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="320" />
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0" ColumnDefinitions="*,Auto,Auto">
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}" />
            <Button x:Name="OpenButton"
                    Grid.Column="1"
                    Content="Ouvrir"
                    FontWeight="SemiBold"
                    Padding="22,8"
                    Margin="8,0,0,0"
                    IsEnabled="False"
                    Click="OpenButton_OnClick" />
            <Button Grid.Column="2"
                    Content="Fermer"
                    Padding="16,8"
                    Margin="8,0,0,0"
                    Click="CloseButton_OnClick" />
        </Grid>
    </Grid>
</Window>
