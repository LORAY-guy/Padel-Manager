<UserControl x:Class="Padel.Manager.Views.SettingsTabView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Padel.Manager">
    <ScrollViewer>
        <StackPanel Margin="24,20" Spacing="20" MaxWidth="600">

            <TextBlock Text="Paramètres"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentText}" />

            <!-- Scoring mode -->
            <Border Padding="16"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderNormal}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Mode de classement"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource AccentText}" />

                    <Border Height="1" Background="{DynamicResource BorderSubtle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Mode Americano"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="12"
                                       MaxWidth="420">
                                <Run Text="Classement par nombre de jeux marqués (scores réels) plutôt que par le système de points Victoire / Nul / Défaite." />
                            </TextBlock>
                            <Border x:Name="AmericanoExampleBadge"
                                    IsVisible="False"
                                    Padding="8,4"
                                    Margin="0,4,0,0"
                                    CornerRadius="4"
                                    Background="#E8F5EE"
                                    BorderBrush="#A3D4B8"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="Ex : 6-3 → joueurs de l'équipe A reçoivent 6 pts, équipe B reçoivent 3 pts"
                                           FontSize="11"
                                           Foreground="#1A7F4B" />
                            </Border>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      x:Name="AmericanoToggle"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"
                                      IsCheckedChanged="AmericanoToggle_OnIsCheckedChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Padding="16"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderNormal}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Apparence"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource AccentText}" />

                    <Border Height="1" Background="{DynamicResource BorderSubtle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Mode sombre"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                            <TextBlock Text="Interface en thème sombre."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="12"
                                       MaxWidth="420" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      x:Name="DarkModeToggle"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"
                                      IsCheckedChanged="DarkModeToggle_OnIsCheckedChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Version -->
            <Border x:Name="VersionSection"
                    IsVisible="False"
                    Padding="16"
                    CornerRadius="8"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderNormal}"
                    BorderThickness="1">
                <Grid>
                    <TextBlock Text="Version"
                               FontSize="13"
                               Foreground="#555" />
                    <TextBlock x:Name="VersionText"
                               HorizontalAlignment="Right"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentText}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
