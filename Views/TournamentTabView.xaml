<UserControl x:Class="Padel.Manager.Views.TournamentTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="1100">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="10"
                BorderBrush="#D8DDE8"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Date du tournoi" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <DatePicker x:Name="TournamentDatePicker" SelectedDateChanged="TournamentDatePicker_OnSelectedDateChanged" />

                    <Button Content="Charger le tournoi"
                            Padding="0,5"
                            Margin="0,10,0,5"
                            Click="LoadTournamentButton_OnClick" />
                    <Button Content="Enregistrer le tournoi"
                            Padding="0,5"
                            Margin="0,0,0,5"
                            Click="SaveTournamentButton_OnClick" />
                    <Button Content="Appliquer la date à tous les matchs"
                            Padding="0,5"
                            Click="ApplyDateToAllMatchesButton_OnClick" />
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding TournamentPlayerPool}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="False" Margin="2">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock VerticalAlignment="Center" Width="160" Text="{Binding Player.Name}" />
                                <TextBlock VerticalAlignment="Center" Width="Auto" Text="{Binding Player.Level, StringFormat=Niveau {0}}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Tout sélectionner" Padding="10,5" Click="SelectAllPlayersButton_OnClick" />
                    <Button Grid.Column="2" Content="Tout désélectionner" Padding="10,5" Click="ClearPlayersButton_OnClick" />
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,5,0,0">
                    <Button Content="Générer le tournoi"
                            Padding="0,5"
                            Click="GenerateBracketButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Content="Modifier dates par catégorie"
                        Padding="20,10"
                        Click="EditDatesByCategoryButton_OnClick" />
                <Button Grid.Column="4"
                        Content="Exporter tournoi (Image)"
                        Padding="20,10"
                        Click="ExportBracketImageButton_OnClick" />
                <Button Grid.Column="5"
                        Content="Imprimer"
                        Padding="20,10"
                        Margin="8,0,0,0"
                        Click="PrintBracketButton_OnClick" />
            </Grid>

            <DataGrid Grid.Row="1"
                      x:Name="TournamentMatchesDataGrid"
                      ItemsSource="{Binding TournamentMatches}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tour" Binding="{Binding RoundNumber}" Width="55" IsReadOnly="True" />
                    <DataGridTextColumn Header="Match" Binding="{Binding MatchNumber}" Width="60" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Date" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MatchDate, StringFormat=dd/MM/yyyy}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding MatchDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Équipe A" Binding="{Binding TeamA, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="Points A" Binding="{Binding ScoreA, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                    <DataGridTextColumn Header="Équipe B" Binding="{Binding TeamB, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="Points B" Binding="{Binding ScoreB, UpdateSourceTrigger=PropertyChanged}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Style d'impression:" />
                    <ComboBox x:Name="PrintStyleComboBox"
                              Width="Auto"
                              MinWidth="120"
                              SelectionChanged="PrintStyleComboBox_OnSelectionChanged" />
                </StackPanel>
            </Grid>

            <GroupBox Grid.Row="3" Header="Aperçu de la feuille à imprimer" Margin="0,10,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Border x:Name="TournamentPrintablePanel"
                            Margin="10"
                            Padding="16"
                            ClipToBounds="True"
                            Background="White"
                            BorderBrush="#CFD8E6"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock x:Name="TournamentTitleTextBlock"
                                       HorizontalAlignment="Center"
                                       FontSize="28"
                                       Margin="0,0,0,15"
                                       FontWeight="Bold"
                                       Foreground="#FF0000"
                                       Text="TOURNOI" />

                            <Canvas x:Name="BracketCanvas" MinWidth="900" MinHeight="420" ClipToBounds="True" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
